# Build output
dist/

# Lighthouse CI reports
.lighthouseci/

# Node
node_modules/
npm-debug.log*

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp

# `npm run lighthouse` on WSL: chrome-launcher sees WSL, takes its Windows
# branch, and builds the Chrome profile path out of a Windows AppData location
# it cannot resolve — so it lands relative to the repo as `undefined:/...` and
# `\\wsl.localhost\...` (chrome-launcher makeTmpDir(), the `wsl` case). Harmless
# but not committable. CI runners are plain Linux and never hit it.
/undefined*
/[\\]*

# Local tool caches. `graft/` is an agent-side code-index cache, not part of
# the site: it holds per-worker state (`.cache/stats.json` records the last
# file that worker touched), so every branch that commits it conflicts with
# every other branch that commits it. Nothing in this repo references graft/,
# so the whole directory is ignored; narrow this to `graft/.cache/` if graft
# ever gains committable config.
graft/
